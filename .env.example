# ============================================================
# The Wanderer Outdoors — environment variables (server only)
# ------------------------------------------------------------
# Copy this file to ".env" and fill in real values. ".env" is git-ignored
# and must NEVER be committed. The Google Places API key is used ONLY by the
# server proxy (/api/google-reviews) and is never sent to the browser.
# On Vercel, enter these under Project Settings -> Environment Variables.
# ============================================================

# Google Places API key — server-side only.
# Create one at: Google Cloud Console -> APIs & Services -> Credentials.
# Enable "Places API (New)" or the classic "Places API".
# This key is read by the server proxy and must NOT be exposed in frontend code.
GOOGLE_PLACES_API_KEY=

# (Optional) Override the public site origin if you host on a custom domain,
# e.g. https://www.wandereroutdoors.in — used to build canonical/cache keys.
SITE_ORIGIN=https://www.wandereroutdoors.in

# ============================================================
# NOTE: Supabase credentials (URL + anon key) live in assets/js/config.js
# and are safe to commit to GitHub — Row Level Security protects your data.
# The anon key is designed to be public; it cannot write or read private data
# without authenticated editor access.
# The Google Places API key, however, MUST live only in the server
# environment (.env / Vercel dashboard), never in frontend code or config.js.
# ============================================================
